{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packages.broos.app/schemas/channel-v1.json",
  "title": "Broos release channel",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "version", "publishedAt", "minimumVersion", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "enum": ["stable", "preview", "edge"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "minimumVersion": { "type": "string" },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percentage", "seed"],
      "properties": {
        "percentage": { "type": "integer", "minimum": 0, "maximum": 100 },
        "seed": { "type": "string", "minLength": 16 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "architecture", "sha256", "size"],
        "properties": {
          "name": { "type": "string" },
          "architecture": { "enum": ["amd64", "arm64", "all"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "releaseNotes": { "type": "string", "format": "uri" },
    "sourceOffer": { "type": "string", "format": "uri" },
    "sbom": { "type": "string", "format": "uri" }
  }
}
